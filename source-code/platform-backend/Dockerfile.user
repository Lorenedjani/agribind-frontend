# Use the SAME unified Dockerfile approach
ARG SERVICE_NAME=user-management-service

FROM maven:3.9-eclipse-temurin-17 AS builder

WORKDIR /app

# Copy parent POM (from your agribind-platform)
COPY pom.xml .
RUN mvn clean install -N -DskipTests

# Build user-management-service
COPY user-management-service/pom.xml user-management-service/pom.xml
COPY user-management-service/src user-management-service/src

WORKDIR /app/user-management-service
RUN mvn clean package -DskipTests

FROM eclipse-temurin:17-jre-alpine AS runtime

RUN addgroup -S spring && adduser -S spring -G spring
USER spring:spring

# Create log directory
RUN mkdir -p /app/logs && chown -R spring:spring /app/logs

COPY --from=builder /app/user-management-service/target/*.jar app.jar

EXPOSE 8084

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8084/actuator/health || exit 1

ENTRYPOINT ["java", "-Xmx512m", "-jar", "/app.jar"]