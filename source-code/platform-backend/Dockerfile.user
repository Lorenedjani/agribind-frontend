# Multi-stage build for efficiency
FROM maven:3.9-eclipse-temurin-17 AS builder

WORKDIR /app

# 1. Install parent POM (critical for multi-module builds)
COPY pom.xml .
RUN mvn clean install -N -DskipTests

# 2. Build user-management-service module
COPY user-management-service/pom.xml user-management-service/
COPY user-management-service/src user-management-service/src

WORKDIR /app/user-management-service
RUN mvn clean package -DskipTests

# 3. Runtime stage
FROM eclipse-temurin:17-jre-alpine AS runtime

# Create user and directory as ROOT first
RUN addgroup -S spring && adduser -S spring -G spring

# Create app directory and set ownership
RUN mkdir -p /app && chown -R spring:spring /app

# Switch to non-root user for security
USER spring:spring

# Set working directory
WORKDIR /app

# CRITICAL FIX: Copy from correct location
# The JAR is in /app/user-management-service/target/ in builder stage
COPY --chown=spring:spring --from=builder /app/user-management-service/target/*.jar app.jar

EXPOSE 8084

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8084/actuator/health || exit 1

# Use absolute path to the JAR
ENTRYPOINT ["java", "-Xmx512m", "-jar", "app.jar"]