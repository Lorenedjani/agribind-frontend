-- Create base users table
CREATE TABLE users (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    user_id VARCHAR(20) UNIQUE NOT NULL,
    type ENUM('FARMER', 'COOPERATIVE', 'GOVERNMENT') NOT NULL,
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255) UNIQUE,
    phone_number VARCHAR(25) UNIQUE NOT NULL,
    status ENUM('ACTIVE', 'INACTIVE', 'PENDING', 'SUSPENDED', 'DELETED') DEFAULT 'ACTIVE',
    registration_number VARCHAR(50) UNIQUE,
    qr_code_data TEXT,

    -- Address fields
    region ENUM('ADAMAOUA', 'CENTRE', 'EST', 'EXTREME_NORD', 'LITTORAL', 'NORD', 'NORD_OUEST', 'OUEST', 'SUD', 'SUD_OUEST'),
    department VARCHAR(100),
    district VARCHAR(100),
    village VARCHAR(100),
    gps_coordinates VARCHAR(100),

    -- Audit fields
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    created_by VARCHAR(100),
    modified_by VARCHAR(100),
    version BIGINT DEFAULT 0,

    notes TEXT,

    INDEX idx_user_id (user_id),
    INDEX idx_phone (phone_number),
    INDEX idx_email (email),
    INDEX idx_registration (registration_number),
    INDEX idx_type (type),
    INDEX idx_status (status),
    INDEX idx_region (region),
    INDEX idx_created_at (created_at)
);